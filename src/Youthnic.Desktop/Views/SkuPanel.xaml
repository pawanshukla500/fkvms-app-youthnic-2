<UserControl x:Class="Youthnic.Desktop.Views.SkuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header: Youthnic Brand & Marketplace Badge -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="8,6" Background="#F8FAFC"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="White"
                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="2">
                        <Image Source="pack://application:,,,/Youthnic.Desktop;component/Assets/youthnic_logo.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="YOUTHNIC" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Packing Station" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="MarketplaceBadge" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image x:Name="MarketplaceLogo" Width="20" Height="20" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,6,0"/>
                    <TextBlock x:Name="MarketplaceText" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Product image / state area -->
        <Border Grid.Row="1" Background="#F4F6F9" CornerRadius="6"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                MinHeight="260" MaxHeight="500">
            <Grid>
                <!-- Idle -->
                <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Awaiting scan" FontSize="16" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan an AWB barcode in the VMS" FontSize="12"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
                    <TextBlock x:Name="LoadingText" Text="Looking up SKU…" FontSize="13"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Not found / pending sync / error -->
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="MessageGlyph" Text="?" FontSize="44" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MessageTitle" Text="Not found" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="300"/>
                    <TextBlock x:Name="MessageHint" FontSize="12" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                    <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" Padding="20,6" MinHeight="28"
                            Click="RetryButton_Click"/>
                </StackPanel>

                <!-- Product image -->
                <Image x:Name="ProductImage" Stretch="Uniform" Margin="10"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed"/>

                <!-- Placeholder glyph shown inside the image area when no image is available -->
                <TextBlock x:Name="ImageMissingOverlay" Text="No image"
                           Foreground="{StaticResource TextMuted}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" IsHitTestVisible="False"/>

                <!-- Multi-Quantity Alert Popup Overlay -->
                <Border x:Name="MultiQtyOverlay" Visibility="Collapsed"
                        Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="2" CornerRadius="10"
                        Margin="12" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Padding="16,14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#D97706" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                            <TextBlock Text="⚠ MULTI-QUANTITY ALERT" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="MultiQtyTitle" Text="2 UNITS TO PACK" FontSize="20" FontWeight="Bold"
                                   Foreground="#92400E" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="MultiQtyDesc" Text="This shipment contains 2 items. Verify all pieces before sealing."
                                   FontSize="12" Foreground="#B45309" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="280"/>
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="MultiQtyCountdownText" Text="Auto-closing in 3s…" FontSize="11"
                                       Foreground="#92400E" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Button Content="Got It" Style="{StaticResource SecondaryButton}" Padding="14,4" FontSize="11"
                                    HorizontalAlignment="Right" Click="DismissMultiQty_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Wrong Marketplace Alert Popup Overlay -->
                <Border x:Name="WrongMarketplaceOverlay" Visibility="Collapsed"
                        Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="10"
                        Margin="12" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Padding="16,14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#DC2626" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                            <TextBlock Text="🚫 WRONG MARKETPLACE" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Border>
                        <TextBlock Text="WRONG DESK SCANNED!" FontSize="18" FontWeight="Bold"
                                   Foreground="#991B1B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="WrongMarketplaceDesc" Text="This barcode belongs to another marketplace!"
                                   FontSize="12" Foreground="#B91C1C" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="280"/>
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="WrongMarketplaceCountdownText" Text="Alert closing in 3s…" FontSize="11"
                                       Foreground="#991B1B" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Button Content="Dismiss" Style="{StaticResource SecondaryButton}" Padding="14,4" FontSize="11"
                                    HorizontalAlignment="Right" Click="DismissWrongMarketplace_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SKU identity -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="SkuNameText" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SkuIdText" FontSize="13" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Additional items in multi-SKU shipments -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0"
                    Visibility="{Binding ElementName=AdditionalItemsList, Path=HasItems, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Also in this shipment" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AdditionalItemsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                                    Padding="0,4" Height="28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="26"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80" MaxWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Quantity}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sku}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Sku}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SkuName}" Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SkuName}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Tiny status line -->
        <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="11" Foreground="{StaticResource TextMuted}"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
