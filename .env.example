# Youthnic Packing Desk — configuration template
# Copy to .env for local development. NEVER commit the real .env.
# The real .env is gitignored and must never be bundled into the installer.

# ---- Flipkart VMS ----
FLIPKART_VMS_URL=https://fkvms.synlabs.io/
FLIPKART_VMS_USERNAME=
FLIPKART_VMS_PASSWORD=
FLIPKART_VMS_FEED_ID=

# ---- Myntra VMS ----
MYNTRA_VMS_URL=
MYNTRA_VMS_USERNAME=
MYNTRA_VMS_PASSWORD=
MYNTRA_VMS_FEED_ID=

# ---- Lookup backend (Youthnic.LookupApi) ----
# Read-only connection to the existing Forward Scan PostgreSQL database.
# The desktop app NEVER connects to PostgreSQL directly; it calls the API.
# Verified 2026-10-24: the Forward Scan app itself connects to
# postgresql://pawanshukla:<password>@200.141.1.119:5433/forward_scan?sslmode=disable
# (see "Forward Scan Project" .env). Prefer a dedicated read-only role (DEPLOYMENT.md §1.1);
# until then, the API enforces read-only transactions in addition to role permissions.
VMS_DATABASE_URL=postgresql://vms_reader:<READ_ONLY_PASSWORD>@200.141.1.119:5433/forward_scan
VMS_DATABASE_READ_ONLY=true
VMS_DB_QUERY_TIMEOUT_MS=2000
VMS_LOOKUP_CACHE_SECONDS=60

# ---- Forward Scan schema mapping (verified 2026-10-24; auto-match finds all of these) ----
# Only needed if auto-match fails. The real schema: single orders table with the AWB and
# seller account name on the row, line items inside a JSON array column, photo cache table.
# FS_SCHEMA_ORDERS=public
# FS_ORDERS_TABLE=oms_orders
# FS_COL_TRACKING=tracking_norm
# FS_COL_SELLER=channel_label
# FS_ITEMS_JSON_COLUMN=items_json
# FS_SKU_MAP_TABLE=sku_photos
# FS_COL_SKU=sku
# FS_COL_SKU_NAME=title
# FS_IMAGE_TABLE=sku_photos
# FS_COL_IMAGE_URL=image_url
# Note: there is NO marketplace column on oms_orders (marketplace lives on the
# `channels` master table) — leave FS_COL_MARKETPLACE unset; filter by seller instead.

# ---- Lookup API tuning ----
# Forward Scan copies orders every ~5 minutes, so a fresh order may be pending sync.
LOOKUP_API_URL=http://127.0.0.1:5080
