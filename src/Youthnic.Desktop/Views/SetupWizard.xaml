<Window x:Class="Youthnic.Desktop.Views.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup — Youthnic Packing Desk"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackground}"
        ResizeMode="NoResize">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="6" Background="White"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Margin="0,0,10,0" Padding="2">
                <Image Source="/Assets/youthnic_logo.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="Desk setup" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="StepTitle" Grid.Row="1" Text="Device" FontSize="13"
                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,14"/>

        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="24">
            <StackPanel>

                <!-- Step 0: Device -->
                <StackPanel x:Name="DevicePage">
                    <TextBlock Text="Device ID" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBox x:Name="DeviceIdBox" Margin="0,6,0,0" Padding="8,6" FontFamily="Consolas"/>
                    <TextBlock Text="Unique identifier for this machine. Auto-generated — edit only to restore a previous identity."
                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock Text="Desk name" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,20,0,0"/>
                    <TextBox x:Name="DeskNameBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="Shown on reports from this packing station (e.g. Desk 3)."
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Step 1: Flipkart -->
                <StackPanel x:Name="FlipkartPage" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource FlipkartBlue}" Margin="0,0,10,0">
                            <Image Source="pack://application:,,,/Youthnic.Desktop;component/Assets/flipkart_icon.png" Width="22" Height="22" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Flipkart VMS" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource FlipkartBlue}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="VMS URL" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,0"/>
                    <TextBox x:Name="FkUrlBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <TextBox x:Name="FkUserBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="FkPassBox" Grid.Column="0" Padding="8,6"/>
                        <TextBox x:Name="FkPassTextBox" Grid.Column="0" Padding="8,6" Visibility="Collapsed"/>
                        <Button x:Name="FkTogglePassButton" Grid.Column="1" Content="👁 Show" Margin="6,0,0,0"
                                Padding="10,4" Style="{StaticResource SecondaryButton}" Click="FkTogglePass_Click"/>
                    </Grid>
                    <TextBlock Text="Feed ID" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <TextBox x:Name="FkFeedBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="The feed id this desk connects to (usually scanned from the VMS station sheet)."
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="Seller account (optional)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <ComboBox x:Name="FkSellerBox" IsEditable="True" Margin="0,6,0,0" Padding="8,6"
                               ToolTip="Pick a preset or type the exact Forward Scan seller name.">
                        <ComboBoxItem Content="ETHNIC JUNCTION - Flipkart"/>
                    </ComboBox>
                    <TextBlock Text="Exact Forward Scan seller name, e.g. ETHNIC JUNCTION - Flipkart. Pick a preset or type any other account. Narrows the SKU lookup when the same tracking ID exists under multiple accounts."
                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Step 2: Myntra -->
                <StackPanel x:Name="MyntraPage" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource MyntraPink}" Margin="0,0,10,0">
                            <Image Source="pack://application:,,,/Youthnic.Desktop;component/Assets/myntra_logo.png" MaxWidth="26" MaxHeight="26" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Myntra VMS" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MyntraPink}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Optional. Leave the VMS URL empty to skip Myntra on this desk."
                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                    <TextBlock Text="VMS URL" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,0"/>
                    <TextBox x:Name="MyUrlBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <TextBox x:Name="MyUserBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="MyPassBox" Grid.Column="0" Padding="8,6"/>
                        <TextBox x:Name="MyPassTextBox" Grid.Column="0" Padding="8,6" Visibility="Collapsed"/>
                        <Button x:Name="MyTogglePassButton" Grid.Column="1" Content="👁 Show" Margin="6,0,0,0"
                                Padding="10,4" Style="{StaticResource SecondaryButton}" Click="MyTogglePass_Click"/>
                    </Grid>
                    <TextBlock Text="Feed ID" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <TextBox x:Name="MyFeedBox" Margin="0,6,0,0" Padding="8,6"/>
                    <TextBlock Text="Seller account (optional)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <ComboBox x:Name="MySellerBox" IsEditable="True" Margin="0,6,0,0" Padding="8,6"
                              ToolTip="Pick a preset or type the exact Forward Scan seller name.">
                        <ComboBoxItem Content="ETHNIC JUNCTION - Myntra Youthnic"/>
                        <ComboBoxItem Content="VB EXPORT - Myntra PPMP"/>
                    </ComboBox>
                    <TextBlock Text="Exact Forward Scan seller name, e.g. ETHNIC JUNCTION - Myntra Youthnic or VB EXPORT - Myntra PPMP. Pick a preset or type any other account."
                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Step 3: Lookup API -->
                <StackPanel x:Name="LookupPage" Visibility="Collapsed">
                    <TextBlock Text="Lookup API" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Base URL of the SKU lookup service (runs on this PC or a LAN server). The desk calls GET {url}/health and GET {url}/api/lookup."
                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Lookup API URL" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,16,0,0"/>
                    <TextBox x:Name="LookupUrlBox" Margin="0,6,0,0" Padding="8,6" FontFamily="Consolas"/>
                    <TextBlock Text="API key (optional — required for hosted server)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,14,0,0"/>
                    <TextBox x:Name="LookupKeyBox" Margin="0,6,0,0" Padding="8,6" FontFamily="Consolas"/>
                    <TextBlock Text="Shared key sent as X-Api-Key on every lookup request. Required only when the hosted lookup server has key auth enabled — leave empty for the desk-side API on this PC."
                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="TestConnectionButton" Content="Test connection"
                                Style="{StaticResource SecondaryButton}" Click="TestConnection_Click"/>
                        <TextBlock x:Name="TestResultText" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 4: Finish -->
                <StackPanel x:Name="FinishPage" Visibility="Collapsed">
                    <TextBlock Text="Ready" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20"/>
                    <TextBlock Text="Credentials are encrypted with Windows DPAPI and stored only on this machine."
                               FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="Back_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="NextButton" Content="Next" Margin="10,0,0,0" Click="Next_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
