<Window x:Class="Youthnic.Desktop.Views.PackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:Youthnic.Desktop.Views"
        Title="Youthnic Packing Desk"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PrimaryModalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78*"/>
            <ColumnDefinition Width="22*"/>
        </Grid.ColumnDefinitions>

        <!-- Main VMS Browser Area -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="0" Grid.Column="0"/>

        <!-- Sku Info & Product Preview Side Panel -->
        <views:SkuPanel x:Name="Panel" Grid.Row="0" Grid.Column="1"
                        Background="White"/>

        <!-- Multi-Item Parcel Modal Popup Overlay (Image 4) -->
        <Grid x:Name="MultiItemModalOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
              Background="#CC0B0F19" Visibility="Collapsed" Panel.ZIndex="100"
              MouseDown="MultiItemModalOverlay_MouseDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                    MaxWidth="960" MinWidth="520" MaxHeight="620" Margin="24"
                    MouseDown="ModalContent_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270"
                                      Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Amber Header Banner (Image 4) -->
                    <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0" Padding="20,16">
                        <Grid>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📦" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModalBannerTitle" Text="MULTI-ITEM PARCEL — PACK ALL 2"
                                               FontWeight="Bold" FontSize="18" Foreground="#92400E"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ModalBannerSubtitle"
                                           Text="2 items · 2 different SKUs · FMPC6679587158"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#B45309"
                                           Margin="30,4,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Style="{StaticResource SecondaryButton}"
                                    Width="32" Height="32" Padding="0" FontSize="14" FontWeight="Bold"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="CloseModal_Click" ToolTip="Close (Esc)"/>
                        </Grid>
                    </Border>

                    <!-- Scrollable Product Cards Row (Image 4) -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Padding="20" Background="#F8FAFC">
                        <ItemsControl x:Name="ModalProductItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="10" Margin="10,4" Width="200"
                                            Padding="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                              Opacity="0.08" Color="#0F172A"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="190"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Thumbnail image with Top-Right Yellow/Amber x{Qty} badge -->
                                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Image}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>

                                                    <!-- Fallback when image loading -->
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding IsLoadingImage, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="📷" FontSize="30" HorizontalAlignment="Center"
                                                                   Foreground="#94A3B8"/>
                                                        <TextBlock Text="Photo loading…" FontSize="11"
                                                                   Foreground="#64748B" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding Size, StringFormat='Size: {0}'}"
                                                                   FontSize="11" FontWeight="Bold" Foreground="#0284C7"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <!-- Yellow / Amber x{Quantity} badge -->
                                                    <Border Background="#F59E0B" CornerRadius="6" Padding="8,4"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}"
                                                                   FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Product Title -->
                                            <TextBlock Grid.Row="1" Text="{Binding SkuName}"
                                                       FontWeight="Bold" FontSize="12" Foreground="#1E293B"
                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                       Margin="0,8,0,0"/>

                                            <!-- SKU -->
                                            <TextBlock Grid.Row="2" Text="{Binding Sku}"
                                                       FontSize="11" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>

                                            <!-- Size Badge -->
                                            <Border Grid.Row="3" Background="#F0F9FF" BorderBrush="#BAE6FD"
                                                    BorderThickness="1" CornerRadius="4" Padding="8,3"
                                                    HorizontalAlignment="Left" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Size, StringFormat='Size: {0}', FallbackValue='Size: -'}"
                                                           FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer with Countdown & Dismiss Button -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12" Padding="20,12">
                        <Grid>
                            <TextBlock x:Name="ModalCountdownText"
                                       Text="Closes in 5s · click outside or press Esc to close now"
                                       FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button Content="Got It" Style="{StaticResource PrimaryModalButton}"
                                    HorizontalAlignment="Right" Click="CloseModal_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Thin status strip with integrated update controls -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1F2430" Padding="14,7">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="Starting…" Foreground="#9AA3B2" FontSize="12"/>
                    <TextBlock x:Name="StatusText" Foreground="#F0C36D" FontSize="12" Margin="16,0,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="UpdateProgressText" Foreground="#38BDF8" FontSize="12" Margin="16,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PackingUpdateButton" Content="⚡ Update Available"
                            Background="#16A34A" Foreground="White" BorderThickness="0"
                            Padding="12,4" FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="PackingUpdateButton_Click"/>
                    <Button x:Name="CheckUpdatesButton" Content="Check for Updates"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Margin="0,0,8,0" Click="CheckUpdatesButton_Click"/>
                    <Button x:Name="RestartButton" Content="Restart Session"
                            Style="{StaticResource SecondaryButton}" Padding="12,4" FontSize="12"
                            Visibility="Collapsed" Click="RestartButton_Click"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}"
                            Padding="12,4" FontSize="12" Margin="8,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
