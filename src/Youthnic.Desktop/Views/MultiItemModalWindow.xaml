<Window x:Class="Youthnic.Desktop.Views.MultiItemModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="#B30B0F19" ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PrimaryModalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Centered Modal Card Box -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="14" BorderBrush="#CBD5E1" BorderThickness="1"
                MinWidth="540" MaxWidth="1020" MaxHeight="620" Margin="24"
                MouseDown="CardContent_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270"
                                  Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Amber Warning Banner (Image 4) -->
                <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1"
                        CornerRadius="14,14,0,0" Padding="20,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F59E0B" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">
                                <TextBlock Text="⚠" FontSize="20" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BannerTitle" Text="MULTI-ITEM PARCEL — PACK ALL ITEMS"
                                           FontSize="18" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock x:Name="BannerSubtitle" Text="Multiple items in this parcel"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#B45309" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource SecondaryButton}"
                                Width="32" Height="32" Padding="0" FontSize="14" FontWeight="Bold"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="Close_Click" ToolTip="Close (Esc)"/>
                    </Grid>
                </Border>

                <!-- Scrollable Horizontal Cards Row -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Padding="20" Background="#F8FAFC">
                    <ItemsControl x:Name="ProductCardsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Margin="10,4" Width="210" Padding="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270"
                                                          Opacity="0.08" Color="#0F172A"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="190"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Product Image / Loading Placeholder with Top-Right Quantity Badge -->
                                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Image}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Fallback size / loading indication -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Visibility="{Binding IsLoadingImage, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Size, FallbackValue='ITEM'}" FontSize="15"
                                                               FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Photo loading…" FontSize="11" Foreground="#64748B"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Top-Right x{Qty} badge -->
                                                <Border Background="#F59E0B" CornerRadius="6" Padding="8,4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                    <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}"
                                                               FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Grid.Row="1" Text="{Binding SkuName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#0F172A" TextWrapping="Wrap" MaxHeight="38"
                                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>

                                        <!-- SKU code -->
                                        <TextBlock Grid.Row="2" Text="{Binding Sku}" FontSize="11" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>

                                        <!-- Size tag -->
                                        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Size, StringFormat='Size: {0}'}" FontSize="11"
                                                       FontWeight="Bold" Foreground="#0284C7"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer Bar with Countdown & Dismiss Button -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14" Padding="20,12">
                    <Grid>
                        <TextBlock x:Name="CountdownText"
                                   Text="Closes in 2s · press Enter, Esc, or click outside to dismiss"
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button Content="Got It (Enter)" Style="{StaticResource PrimaryModalButton}"
                                HorizontalAlignment="Right" Click="Close_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
