<UserControl x:Class="Youthnic.Desktop.Views.SkuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header: Youthnic Brand, Marketplace Badge, and Scanned AWB -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10,8" Background="#F8FAFC"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="White"
                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="2">
                            <Image Source="pack://application:,,,/Youthnic.Desktop;component/Assets/youthnic_logo.png" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="YOUTHNIC" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Packing Station" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="MarketplaceBadge" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Image x:Name="MarketplaceLogo" Width="20" Height="20" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,6,0"/>
                        <TextBlock x:Name="MarketplaceText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Active Scanned AWB Bar (Visible when AWB is scanned) -->
                <Border x:Name="AwbHeaderBar" Grid.Row="1" Margin="0,8,0,0" Padding="8,5" Background="#EFF6FF"
                        BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AWB: " FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                            <TextBlock x:Name="AwbHeaderText" Text="—" FontSize="12" FontWeight="Bold"
                                       Foreground="#1D4ED8"/>
                        </StackPanel>
                        <Border x:Name="SellerHeaderBadge" HorizontalAlignment="Right" Background="White"
                                BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="SellerHeaderText" Text="Youthnic" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1E40AF"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area: State / Images / Cards -->
        <Border Grid.Row="1" Background="#F4F6F9" CornerRadius="8"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                MinHeight="260">
            <Grid>
                <!-- Idle State -->
                <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Awaiting scan" FontSize="16" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan an AWB barcode in the VMS" FontSize="12"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading State -->
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
                    <TextBlock x:Name="LoadingText" Text="Looking up SKU…" FontSize="13"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Not found / error message -->
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="MessageGlyph" Text="?" FontSize="44" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MessageTitle" Text="Not found" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="300"/>
                    <TextBlock x:Name="MessageHint" FontSize="12" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                    <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" Padding="20,6" MinHeight="28"
                            Click="RetryButton_Click"/>
                </StackPanel>

                <!-- Single Item View: Image + Floating Verification Badges Overlay -->
                <Grid x:Name="SingleItemPanel" Visibility="Collapsed">
                    <!-- Product Image -->
                    <Image x:Name="ProductImage" Stretch="Uniform" Margin="8"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="Collapsed"/>

                    <!-- Fallback placeholder when no photo is available -->
                    <Border x:Name="ImagePlaceholderCard" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="#F8FAFC" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                            CornerRadius="10" Padding="20,16" Margin="12" MaxWidth="320">
                        <StackPanel HorizontalAlignment="Center">
                            <Border x:Name="PlaceholderSizeBadge" Background="#0284C7" CornerRadius="8"
                                    Padding="16,6" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock x:Name="PlaceholderSizeText" Text="SIZE: M" FontSize="16" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="PlaceholderDesignText" Text="Product" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6"/>
                            <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6"
                                    Padding="8,4" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔍 " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Verify Garment Label &amp; Tag" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#92400E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="PlaceholderSubText" Text="Match SKU &amp; size with physical item"
                                       FontSize="10" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Top Floating Verification Badges Overlay (ALWAYS visible when item is displayed!) -->
                    <Grid VerticalAlignment="Top" Margin="12,10" x:Name="SingleItemBadgesOverlay">
                        <!-- Prominent Size Badge on Left -->
                        <Border x:Name="OverlaySizeBadge" Background="#0284C7" CornerRadius="6"
                                Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SIZE: " FontSize="12" FontWeight="SemiBold" Foreground="#E0F2FE" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OverlaySizeText" Text="XL" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Prominent Quantity Badge on Right -->
                        <Border x:Name="OverlayQtyBadge" Background="#16A34A" CornerRadius="6"
                                Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <TextBlock x:Name="OverlayQtyText" Text="✓ 1 UNIT" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Multi-Item View: Cards with photos and x{Qty} badges -->
                <Grid x:Name="MultiItemsPanel" Visibility="Collapsed" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Alert Banner -->
                    <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#D97706" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontWeight="Bold" FontSize="13" Foreground="#92400E"/>
                            <TextBlock x:Name="MultiItemBannerText" Text="MULTI-ITEM: 2 items · 2 different SKUs"
                                       FontWeight="Bold" FontSize="11" Foreground="#92400E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Product Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MultiItemsGrid">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                            CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail image with Qty badge -->
                                            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Width="80" Height="80"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Image}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                                                    
                                                    <!-- Fallback size badge when image loading -->
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding IsLoadingImage, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Size, FallbackValue='ITEM'}" FontSize="11"
                                                                   FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Photo loading" FontSize="9" Foreground="{StaticResource TextMuted}"
                                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Top-Right x{Qty} badge -->
                                                    <Border Background="#F59E0B" CornerRadius="4" Padding="5,2"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}"
                                                                   FontWeight="Bold" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Item details -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SkuName}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Size, StringFormat='Size: {0}'}" FontSize="10"
                                                                   FontWeight="Bold" Foreground="#0284C7"/>
                                                    </Border>
                                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontSize="10"
                                                                   FontWeight="Bold" Foreground="#15803D"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Wrong Marketplace Alert Overlay -->
                <Border x:Name="WrongMarketplaceOverlay" Visibility="Collapsed"
                        Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="2" CornerRadius="10"
                        Margin="12" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                        Padding="16,14">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#DC2626" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                            <TextBlock Text="🚫 WRONG MARKETPLACE" FontWeight="Bold" FontSize="11" Foreground="White"/>
                        </Border>
                        <TextBlock Text="WRONG DESK SCANNED!" FontSize="18" FontWeight="Bold"
                                   Foreground="#991B1B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="WrongMarketplaceDesc" Text="This barcode belongs to another marketplace!"
                                   FontSize="12" Foreground="#B91C1C" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="280"/>
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="WrongMarketplaceCountdownText" Text="Alert closing in 3s…" FontSize="11"
                                       Foreground="#991B1B" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Button Content="Dismiss" Style="{StaticResource SecondaryButton}" Padding="14,4" FontSize="11"
                                    HorizontalAlignment="Right" Click="DismissWrongMarketplace_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Single Item Verification Details (Shown for single-item scans) -->
        <Border x:Name="SingleItemDetails" Grid.Row="2" Margin="0,10,0,0" Padding="10,8"
                Background="#F8FAFC" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <!-- SKU Badge / Code -->
                <Border Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                        CornerRadius="4" Padding="8,4" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SKU: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="SkuCodeText" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Product Title -->
                <TextBlock x:Name="SkuNameText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           MaxHeight="36" TextTrimming="CharacterEllipsis"/>

                <!-- Verification Checklist Summary Box -->
                <Border Margin="0,8,0,0" Padding="8,6" Background="#FFFFFF" BorderBrush="#E2E8F0"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Size Check -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SIZE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="VerifySizeText" Text="XL" FontSize="13" FontWeight="Bold"
                                       Foreground="#0284C7" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Quantity Check -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="QUANTITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="VerifyQtyText" Text="1 Unit" FontSize="13" FontWeight="Bold"
                                       Foreground="#16A34A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Seller / Polybag Check -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BRAND / POLYBAG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="VerifySellerText" Text="ETHNIC JUNCTION" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Status line -->
        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="11" Foreground="{StaticResource TextMuted}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
