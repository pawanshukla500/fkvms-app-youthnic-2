<Window x:Class="Youthnic.Desktop.Views.PackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:Youthnic.Desktop.Views"
        Title="Youthnic Packing Desk"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78*"/>
            <ColumnDefinition Width="22*"/>
        </Grid.ColumnDefinitions>

        <!-- Main VMS Browser Area -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="0" Grid.Column="0"/>

        <!-- Sku Info & Product Preview Side Panel -->
        <views:SkuPanel x:Name="Panel" Grid.Row="0" Grid.Column="1"
                        Background="White"/>

        <!-- Thin status strip with integrated update controls -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1F2430" Padding="14,7">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="Starting…" Foreground="#9AA3B2" FontSize="12"/>
                    <TextBlock x:Name="ShiftPacksText" Text="Shift: 0 packs" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"
                               Margin="16,0,0,0" ToolTip="Total verified packages completed during this shift"/>
                    <TextBlock x:Name="UploadStatusText" Text="● Uploads Clean (0)" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"
                               Margin="16,0,0,0" ToolTip="VMS video upload status"/>
                    <TextBlock x:Name="StatusText" Foreground="#F0C36D" FontSize="12" Margin="16,0,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="UpdateProgressText" Foreground="#38BDF8" FontSize="12" Margin="16,0,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PackingUpdateButton" Content="⚡ Update Available"
                            Background="#16A34A" Foreground="White" BorderThickness="0"
                            Padding="12,4" FontSize="12" FontWeight="SemiBold"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="PackingUpdateButton_Click"/>
                    <Button x:Name="CheckUpdatesButton" Content="Check for Updates"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Margin="0,0,8,0" Click="CheckUpdatesButton_Click"/>
                    <Button x:Name="SettingsButton" Content="⚙ Settings"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                            Margin="0,0,8,0" Click="SettingsButton_Click"/>
                    <Button x:Name="RestartButton" Content="Restart Session"
                            Style="{StaticResource SecondaryButton}" Padding="12,4" FontSize="12"
                            Visibility="Collapsed" Click="RestartButton_Click"/>
                    <Button Content="Switch Desk" Style="{StaticResource SecondaryButton}"
                            Padding="10,4" FontSize="11" Margin="8,0,4,0" Click="SwitchDeskButton_Click"
                            ToolTip="Return to Marketplace selection"/>
                    <Button Content="Exit App" Background="#DC2626" Foreground="White" BorderThickness="0"
                            Padding="12,4" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"
                            Click="ExitAppButton_Click" ToolTip="Completely close and exit application"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
