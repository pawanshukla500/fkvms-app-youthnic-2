<Window x:Class="Youthnic.Desktop.Views.PackingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:Youthnic.Desktop.Views"
        Title="Youthnic Packing Desk"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78*"/>
            <ColumnDefinition Width="22*"/>
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="WebView" Grid.Row="0" Grid.Column="0"/>

        <views:SkuPanel x:Name="Panel" Grid.Row="0" Grid.Column="1"
                        Background="White"/>

        <!-- Thin status strip -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#1F2430" Padding="14,7">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="Starting…" Foreground="#9AA3B2" FontSize="12"/>
                    <TextBlock x:Name="StatusText" Foreground="#F0C36D" FontSize="12" Margin="16,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RestartButton" Content="Restart Session"
                            Style="{StaticResource SecondaryButton}" Padding="12,4" FontSize="12"
                            Visibility="Collapsed" Click="RestartButton_Click"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}"
                            Padding="12,4" FontSize="12" Margin="8,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
