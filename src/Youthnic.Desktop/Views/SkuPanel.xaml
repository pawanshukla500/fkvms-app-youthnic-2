<UserControl x:Class="Youthnic.Desktop.Views.SkuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#FFFFFF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Product image / state area -->
        <Border Grid.Row="0" Background="#F4F6F9" CornerRadius="6"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                MinHeight="380" MaxHeight="520">
            <Grid>
                <!-- Idle -->
                <StackPanel x:Name="IdlePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Awaiting scan" FontSize="16" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan an AWB barcode in the VMS" FontSize="12"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Loading -->
                <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
                    <TextBlock x:Name="LoadingText" Text="Looking up SKU…" FontSize="13"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Not found / pending sync / error -->
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="MessageGlyph" Text="?" FontSize="44" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MessageTitle" Text="Not found" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="300"/>
                    <TextBlock x:Name="MessageHint" FontSize="12" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                    <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" Padding="20,6" MinHeight="28"
                            Click="RetryButton_Click"/>
                </StackPanel>

                <!-- Product image -->
                <Image x:Name="ProductImage" Stretch="Uniform" Margin="10"
                       Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Placeholder glyph shown inside the image area when no image is available -->
        <TextBlock x:Name="ImageMissingOverlay" Grid.Row="0" Text="No image"
                   Foreground="{StaticResource TextMuted}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- SKU identity -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="SkuNameText" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
            <TextBlock x:Name="SkuIdText" FontSize="13" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Additional items in multi-SKU shipments.
             Scrolls beyond ~6 rows; every row is a fixed height so the list never
             jumps, and both SKU and name are trimmed with a tooltip for the full text. -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0"
                    Visibility="{Binding ElementName=AdditionalItemsList, Path=HasItems, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Also in this shipment" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
            <ScrollViewer MaxHeight="172" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AdditionalItemsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
                                    Padding="0,4" Height="28">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="26"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80" MaxWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Quantity}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sku}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Sku}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SkuName}" Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SkuName}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Tiny status line -->
        <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="11" Foreground="{StaticResource TextMuted}"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
